# Trajectory runs in three modes. Each block below unlocks the next one.
# With none of these set, the app still runs end-to-end on the seed dataset.

# --- Reasoning -------------------------------------------------------------
# Without this, the state engine still computes everything; the narrative is
# generated deterministically instead of by Claude.
ANTHROPIC_API_KEY=

# --- Persistence -----------------------------------------------------------
# Without these, memory/events/audit live in process and reset on restart.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Semantic memory -------------------------------------------------------
# The Claude API has no embeddings endpoint. Without this, memory retrieval
# falls back to keyword + entity-graph matching.
VOYAGE_API_KEY=

# --- Identity --------------------------------------------------------------
TRAJECTORY_OWNER_ID=00000000-0000-0000-0000-000000000001
TRAJECTORY_OWNER_NAME=Davarn
TRAJECTORY_TIMEZONE=Europe/London

# --- Connectors (Phase 2) --------------------------------------------------
# A connector reports "live" only when all of its required vars are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
CALENDAR_REFRESH_TOKEN=
DRIVE_REFRESH_TOKEN=

GITHUB_TOKEN=
NOTION_TOKEN=
SLACK_BOT_TOKEN=
LINEAR_API_KEY=
MCP_SERVER_URL=
