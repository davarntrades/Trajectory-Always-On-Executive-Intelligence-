# Trajectory production environment
# Copy this file to .env.local for local development. Never commit real secrets.

# =============================================================================
# Required — production reasoning and persistent state
# =============================================================================

# Anthropic API key used server-side for executive narrative reasoning.
ANTHROPIC_API_KEY=

# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anonymous key for future authenticated browser access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private server-only Supabase key used for persistence and background writes.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Optional — identity and semantic retrieval
# =============================================================================

# Stable UUID for the single Trajectory owner represented in persisted records.
TRAJECTORY_OWNER_ID=00000000-0000-0000-0000-000000000001

# Name used by the greeting and executive briefing.
TRAJECTORY_OWNER_NAME=Davarn

# IANA timezone used when interpreting schedules and recency.
TRAJECTORY_TIMEZONE=Europe/London

# Enables semantic memory retrieval; keyword and graph retrieval remain available without it.
VOYAGE_API_KEY=

# =============================================================================
# Optional — future connectors (not live until their Phase 2 adapters ship)
# =============================================================================

# Shared Google OAuth application credentials for Gmail and Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long-lived OAuth refresh token for the future Gmail connector.
GMAIL_REFRESH_TOKEN=

# Long-lived OAuth refresh token for the future Google Calendar connector.
CALENDAR_REFRESH_TOKEN=

# Long-lived OAuth refresh token for the future Google Drive connector.
DRIVE_REFRESH_TOKEN=

# Personal or GitHub App token for the future GitHub connector.
GITHUB_TOKEN=

# Internal integration token for the future Notion connector.
NOTION_TOKEN=

# Bot token for the future Slack connector.
SLACK_BOT_TOKEN=

# API key for the future Linear connector.
LINEAR_API_KEY=

# Endpoint for a future external MCP connector server.
MCP_SERVER_URL=
