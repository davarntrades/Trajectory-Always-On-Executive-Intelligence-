# Trajectory production environment. Never commit real values.

# Required — multi-user production
# Public project values. Prefer the new Supabase publishable key; the legacy anon
# key remains supported as a fallback during migration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role. Used only for cron jobs and encrypted OAuth
# records; never give this variable a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Enable only after all Supabase migrations have been applied and Auth providers
# are configured. Keeping this false preserves the existing single-user rollout.
TRAJECTORY_AUTH_ENABLED=false

# Canonical application origin used in auth and connector callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# High-entropy server-only secrets. Generate independently, for example with
# `openssl rand -base64 48`.
CONNECTOR_ENCRYPTION_KEY=
CRON_SECRET=

# Required — configure at least one hosted intelligence provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional provider routing and model overrides
# Values: auto, anthropic, openai, gemini, grok, local.
TRAJECTORY_DEFAULT_PROVIDER=auto
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
GROK_MODEL=

# Local OpenAI-compatible endpoint (Ollama, LM Studio, or a local Llama gateway).
# Keep this unset on Vercel unless the endpoint is private and intentionally reachable.
LOCAL_PROVIDER_BASE_URL=
LOCAL_PROVIDER_API_KEY=
LOCAL_PROVIDER_MODEL=

# Optional — SaaS OAuth connectors. All secrets remain server-side. Register each
# callback as `${NEXT_PUBLIC_APP_URL}/api/connectors/<connector>/callback`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional — semantic retrieval and backward-compatible single-user rollout
VOYAGE_API_KEY=
TRAJECTORY_OWNER_ID=00000000-0000-0000-0000-000000000001
TRAJECTORY_OWNER_NAME=Davarn
TRAJECTORY_TIMEZONE=Europe/London

# Legacy direct-token connectors retained for the pre-auth rollout only.
GMAIL_REFRESH_TOKEN=
CALENDAR_REFRESH_TOKEN=
DRIVE_REFRESH_TOKEN=
GITHUB_TOKEN=
NOTION_TOKEN=
SLACK_BOT_TOKEN=
LINEAR_API_KEY=
MCP_SERVER_URL=
